[Unit]
Description=shim-router (claude-sonnet -> gpt-6-luna -> openrouter sonnet) :8322
After=network-online.target shim-v3.service codex-shim.service

[Service]
ExecStart=/home/vellum/.bun/bin/bun run /home/vellum/shim-router/server.js
EnvironmentFile=/home/vellum/shim-router/env
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
